import logging
import azure.functions as func
import json

def main(msg: func.ServiceBusMessage):
    logging.info('Processing message from Service Bus...')

    try:
        message_body = msg.get_body().decode('utf-8')
        data = json.loads(message_body)
        policy_id = data.get("policyId")
        policy_type = data.get("policyType")

        # Simple validation
        if not policy_id or not policy_type:
            logging.warning(f"Invalid message, sending to DLQ: {data}")
            # raise exception to automatically move to DLQ if configured
            raise ValueError("Invalid policy data")
        
        # Processing logic
        logging.info(f"Processed Policy {policy_id} of type {policy_type} successfully.")

    except Exception as e:
        logging.error(f"Error processing message: {e}")
        raise  # Re-raise to send invalid messages to DLQ